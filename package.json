{
  "name": "splitfire",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Splitfire: a space battleship duel with cluster munitions.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @splitfire/client",
    "build": "npm run build -w @splitfire/client",
    "preview": "npm run preview -w @splitfire/client",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
